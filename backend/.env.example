# Server Configuration
# Render automatically sets PORT. Locally defaults to 5000.
PORT=5000
NODE_ENV=production

# Allowed Frontend Origins (comma-separated if multiple, or * for all)
# Example for Vercel: https://pricepilot.vercel.app or *
CORS_ORIGIN=*

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pricepilot?retryWrites=true&w=majority

# SerpApi Key for Google Shopping & Search Competitor Discovery
# Get a free key at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Gemini AI Configuration (Backend Only - NEVER put in frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
AI_ENABLED=true
AI_MAX_MATCH_CANDIDATES=5
AI_REQUEST_TIMEOUT_MS=15000
AI_DAILY_REQUEST_LIMIT=100

# Automated Price Monitoring Interval (default: 360 = every 6 hours)
PRICE_MONITOR_INTERVAL_MINUTES=360
